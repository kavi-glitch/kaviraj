import pickle,tempfile

f=tempfile.NamedTemporaryFile(delete=False).name

with open(f,"wb") as b:
    while 1:
        e=int(input("Emp No: "))
        n=input("Name: ")
        bs=int(input("Basic: "))
        al=int(input("Allow: "))
        pickle.dump([e,n,bs,al,bs+al],b)
        if input("More(y/n): ")=="n": break

with open(f,"rb") as b:
    try:
        while 1: print(pickle.load(b))
    except: pass

