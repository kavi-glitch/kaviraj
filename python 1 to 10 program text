# Find factorial value using recursion function
def factorial(n):
    if n == 0:
        return 1
    else:
        return n * factorial(n - 1)

# Sum of digits using recursion function
def sum_digits(n):
    if n < 10:
        return n
    else:
        return n % 10 + sum_digits(n // 10)

n1 = int(input("Enter a number to find factorial: "))
n2 = int(input("Enter a positive number to find sum of digits: "))

f = factorial(n1)
s = sum_digits(n2)

print("The Factorial of", n1, "is", f)
print("The Sum of digit", n2, "is", s)





