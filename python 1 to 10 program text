        print("\tTOTAL SALARY : ", t)

        pickle.dump([e, n, bs, al, t], b)
        r += 1
        if input("Do you wish to enter more records (y/n)? ").lower() == 'n':
            print("Record entry OVER\n")
            break

    print("Size of binary file (in bytes):", b.tell())

print("Now reading the employee records from the file\n")

i = 1
try:
    with open(f, "rb") as b:
        while True:
            print("Record Number :", i)
            print(pickle.load(b))
            i += 1
except EOFError:
    pass

