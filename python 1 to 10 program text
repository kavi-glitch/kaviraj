# Program to validate mobile number

def isphonenumber(numStr):
    l = len(numStr)

    if l < 10 or l > 13 or l == 11 or l == 12:
        return False

    for i in range(l):
        if l == 13 and i == 2:
            if numStr[i] != '-':
                return False
        else:
            if not numStr[i].isdigit():
                return False
    return True


